# Base de datos en producción (Turso). Si se dejan vacías se usa el archivo
# local file:local.db, que es lo normal en desarrollo.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Primer administrador que crea `pnpm run db:seed` (RF-U3).
# Estos valores sirven para desarrollo; en producción se cargan otros distintos.
ADMIN_EMAIL=admin@comercio.test
ADMIN_PASSWORD=admin12345
ADMIN_NOMBRE=Administrador

# Clave con la que se firma la cookie de sesión (mínimo 32 caracteres).
# En producción se carga una distinta y secreta. Para generar una:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=clave-de-desarrollo-cambiar-en-produccion-0123456789
